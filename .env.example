DS_API_KEY=replace-with-local-secret
# Optional generic provider overrides; the defaults use DeepSeek's official API.
# CODE_SOUL_BASE_URL=https://api.deepseek.com
# CODE_SOUL_MODEL=deepseek-flash
# CODE_SOUL_API_KEY=replace-with-provider-secret
CODE_SOUL_CONCURRENCY=3
CODE_SOUL_TIMEOUT_MS=600000
CODE_JUDGE_IMAGE=python:3.13-slim
DITTO_PROVIDER_PYTHON=python
MATH_SCORER_PYTHON=python
# MATH tool execution requires Docker and this preloaded baseline image (no pull at runtime).
# DITTO_MATH_PYTHON_IMAGE=sha256:2fc2c915ed384368f492e415d42f7491defbaaa29436b3013e84627fe85b57a6
DITTO_AUTOMATION_ROOT=../AutomationBench-source
DITTO_AUTOMATION_PYTHON=python
# Keep derived API search caches outside the pinned official source checkout.
# DITTO_AUTOMATION_CACHE_DIR=.test-tmp/automation-api-cache
